// Redis package tests - RESP protocol (no server needed).
// These exercise the SHIPPED library in src/redis.wyn (resolved via the
// tests/redis.wyn -> ../src/redis.wyn symlink), so a broken lib fails the tests.
import redis

test "encode PING" {
    assert_eq(redis.resp_cmd1("PING"), "*1\r\n$4\r\nPING\r\n")
}

test "encode GET" {
    assert_eq(redis.resp_cmd2("GET", "key"), "*2\r\n$3\r\nGET\r\n$3\r\nkey\r\n")
}

test "encode SET" {
    assert_eq(redis.resp_cmd3("SET", "k", "v"), "*3\r\n$3\r\nSET\r\n$1\r\nk\r\n$1\r\nv\r\n")
}

test "parse +OK" {
    assert_eq(redis.resp_parse("+OK\r\n"), "OK")
}

test "parse :42" {
    assert_eq(redis.resp_parse(":42\r\n"), "42")
}

test "parse error" {
    assert_eq(redis.resp_parse("-ERR unknown\r\n"), "ERR unknown")
}

test "parse bulk string" {
    assert_eq(redis.resp_parse("$5\r\nhello\r\n"), "hello")
}

test "parse nil" {
    assert_eq(redis.resp_parse("$-1\r\n"), "")
}

test "parse empty" {
    assert_eq(redis.resp_parse(""), "")
}
